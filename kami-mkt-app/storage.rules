rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mídias de posts de redes sociais — leitura pública (Instagram/Meta precisam acessar a URL)
    // Escrita restrita a usuários autenticados
    match /social_media/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Arquivos entregues nos cards do pipeline — acesso restrito a autenticados
    match /cards/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Anexos de solicitações externas — acesso restrito a autenticados
    match /solicitacoes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Demais caminhos — negar por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
